# ==========================================
# Configuración Servidor MCP Activity Tracking
# ==========================================

# URL Base de la API REST Kestrel (HTTP directo en red privada)
API_BASE_URL=http://10.200.1.13:5100
API_FALLBACK_URL=https://10.200.1.13:5443
API_REJECT_UNAUTHORIZED=false
API_TIMEOUT_MS=15000

# MODO DE SEGURIDAD PARA PRODUCCIÓN:
# En true, ninguna llamada de tipo POST/PUT/DELETE tocará la base de datos productiva.
# Las tools validarán esquemas, resolverán datos y retornarán una simulación exitosa.
DRY_RUN_MODE=true

# Credenciales de Autenticación
AUTH_USERNAME=brayan.vazquez
AUTH_PASSWORD=TU_PASSWORD_AQUI

# Parámetros por Defecto
DEFAULT_RESPONSIBLE_ID=6
DEFAULT_RESPONSIBLE_NAME=VAZQUEZ HEREDIA BRAYAN ULISES
DEFAULT_PROJECT_ID=11
DEFAULT_SERVICE_ID=5
